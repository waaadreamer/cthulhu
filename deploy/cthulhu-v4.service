# 安装：cp deploy/cthulhu-v4.service /etc/systemd/system/ && systemctl enable --now cthulhu-v4
[Unit]
Description=Cthulhu v4 center
After=network-online.target

[Service]
# systemd 默认 PATH 不含用户目录；codex/claude 装在 ~/.local/bin，找不到时本机节点只会报告 demo。
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/snap/bin
# 不设置全局代理：模型 CLI 与 GitHub 更新各自通过 start-center.sh 的 --model-proxy / --git-proxy 使用代理。
ExecStart=/root/cthulhu-v4/deploy/start-center.sh
WorkingDirectory=/root/cthulhu-v4
Restart=on-failure
RestartSec=5
# 先 SIGTERM 让中心收尾（停止本机原生进程组、关闭数据库），超时才强杀。
KillMode=mixed
TimeoutStopSec=30
StandardOutput=append:/root/cthulhu-v4/.state/center.log
StandardError=append:/root/cthulhu-v4/.state/center.log

[Install]
WantedBy=multi-user.target
